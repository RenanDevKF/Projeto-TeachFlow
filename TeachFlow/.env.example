SECRET_KEY=

DEBUG=False
ALLOWED_HOSTS=

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

USE_X_FORWARDED_PROTO=False

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

CSRF_TRUSTED_ORIGINS=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TeachFlow <noreply@teachflow.local>

# Banco de dados
# sqlite: ambiente local tradicional
# postgresql: ambiente Docker com PostgreSQL
DB_ENGINE=sqlite

# Utilizadas quando DB_ENGINE=postgresql
DB_NAME=teachflow
DB_USER=teachflow
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
